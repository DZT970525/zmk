config ZITAOTECH_BOOTMAGIC
    bool "ZitaoTech bootmagic (hold a key at power-up to enter the bootloader)"
    select SETTINGS
    help
      QMK style bootmagic: while the keyboard boots, if the configured key is
      held it drops straight into the UF2 bootloader instead of starting ZMK.
      Each half checks its own matrix locally, so either half can do this on its
      own - no connection to the other half, and no knowledge of the active
      layer is needed.

if ZITAOTECH_BOOTMAGIC

config ZITAOTECH_BOOTMAGIC_STUDIO_RPC
    bool "Enable ZitaoTech bootmagic custom Studio RPC"
    depends on ZMK_STUDIO

config ZITAOTECH_BOOTMAGIC_DEFAULT_KEY
    int "Keymap position checked at power-up by default (-1 = none)"
    default -1

endif # ZITAOTECH_BOOTMAGIC
