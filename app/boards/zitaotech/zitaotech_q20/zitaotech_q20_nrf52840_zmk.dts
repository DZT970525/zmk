/*
 * ZitaoTech Q20 (nRF52840, wireless) ZMK board
 *
 * Migrated from the ZMK 3.5 / old-board-scheme tree (app/boards/arm/zitaotech_q20)
 * to the ZMK 0.4 hardware model + Zephyr 4.1:
 *   - board.yml / Kconfig.<board> / <board>_<soc>_<variant> naming,
 *   - zmk,backlight / zmk,layer_indicator / zmk,trackpad_led chosen nodes,
 *   - GPREGRET backed &bootloader (nrf52840_uf2_boot_mode.dtsi).
 *
 * Copyright (c) 2025 ZitaoTech
 *
 * SPDX-License-Identifier: MIT
 */

/dts-v1/;

#include <nordic/nrf52840_qiaa.dtsi>
/* UF2 bootloader support: gives &bootloader a GPREGRET backed boot mode. */
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>

/* Keymap layer used as the automatic mouse layer (see &bbtrackpad_listener). */
#define MOUSE_LAYER_ID 4

#include <behaviors/runtime_tap_dance.dtsi>
#define ZMK_BEHAVIORS_KEEP_DEFAULT_LAYER
#include <behaviors/default_layer.dtsi>
#include "zitaotech_q20-layouts.dtsi"

/ {
    model = "ZitaoTech_q20";
    compatible = "zitaotech,zitaotech-q20";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,console = &cdc_acm_uart;
        zmk,battery = &vbatt;
        zmk,kscan = &kscan0;
        zmk,physical-layouts = &zitaotech_q20_layout;
        zmk,backlight = &backlight;
        zmk,layer_indicator = &layer_indicator;
        zmk,trackpad_led = &trackpad_led;
        zmk,studio-rpc-uart = &cdc_acm_uart; /* ZMK Studio over the console CDC ACM */
    };

    input_processors {
        /* Holds MOUSE_LAYER_ID while the trackpad reports movement. */
        zip_temp_layer: zip_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
        };
    };

    /*
     * Keyboard backlight: the two LED strings are driven by PWM0 (P1.13) and
     * PWM1 (P0.17).  Both are children of the backlight node so that ZMK's
     * backlight sets them together.
     */
    backlight: backlight {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };

    };

    /*
     * Layer indicator LED (PWM2 on P0.15): one LED that shows a different
     * effect for each active layer (custom_driver/layer_indicator.c, driven by
     * zmk-feature-zitaotech-backlight for the runtime selected effects).
     */
    layer_indicator: layer_indicator {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm2 0 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
        pwm_led_1 {
            pwms = <&pwm1 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
        };
    };

    /* Trackpad backlight LED (PWM3 on P0.10). */
    trackpad_led: trackpad_led {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm3 0 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <7>;
        map = <
RC(0,0)          RC(0,2)             RC(0,3)             RC(0,4)          RC(0,9)
RC(1,1)  RC(3,1) RC(1,3) RC(5,2) RC(3,2) RC(3,5) RC(1,5) RC(3,4) RC(1,4)  RC(6,8)
RC(2,1)  RC(1,2) RC(3,0) RC(1,0) RC(5,0) RC(5,5) RC(1,6) RC(3,7) RC(2,7)  RC(3,8)
RC(4,0)  RC(2,0) RC(5,1) RC(2,3) RC(5,3) RC(2,5) RC(5,6) RC(3,6) RC(4,7)  RC(4,8)
RC(4,1)          RC(4,3)             RC(4,5)             RC(4,6)          RC(4,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios
            = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 13  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&gpio0 24  GPIO_ACTIVE_HIGH>
            , <&gpio1 0  GPIO_ACTIVE_HIGH>
            , <&gpio0 9  GPIO_ACTIVE_HIGH>
            , <&gpio0 22 GPIO_ACTIVE_HIGH>
            , <&gpio1 3 GPIO_ACTIVE_HIGH>
            , <&gpio1 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 20 GPIO_ACTIVE_HIGH>
            , <&gpio1 1 GPIO_ACTIVE_HIGH>
            , <&gpio0 7 GPIO_ACTIVE_HIGH>
            , <&gpio1 10 GPIO_ACTIVE_HIGH>
            ;
    };


    /* Node name must match original "EXT_POWER" label to preserve user settings. */
    EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio1 15 GPIO_ACTIVE_LOW>;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 2>;
        output-ohms = <2000000>;
        full-ohms = <2820000>;  // 2000000 + 820000
    };
};

&adc {
    status = "okay";
};

/*
 * Use the SoC's DC/DC converter.  Zephyr 4.x configures this through
 * devicetree; the old CONFIG_SOC_DCDC_NRF52X Kconfig symbol is deprecated.
 */
&reg1 {
    regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_default>;
    pinctrl-1 = <&pwm1_sleep>;
    pinctrl-names = "default", "sleep";
};

&pwm2 {
    status = "okay";
    pinctrl-0 = <&pwm2_default>;
    pinctrl-1 = <&pwm2_sleep>;
    pinctrl-names = "default", "sleep";
};

&pwm3 {
    status = "okay";
    pinctrl-0 = <&pwm3_default>;
    pinctrl-1 = <&pwm3_sleep>;
    pinctrl-names = "default", "sleep";
};

&usbd {
    status = "okay";
    cdc_acm_uart: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

&zitaotech_q20_layout {
    transform = <&default_transform>;
    kscan = <&kscan0>;
};

zephyr_udc0: &usbd {
    compatible = "nordic,nrf-usbd";
    status = "okay";
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    bbtrackpad: a320@3b {
        compatible = "avago,a320";
        reg = <0x3b>;
        status = "okay";
    };
};

/ {
    bbtrackpad_listener: bbtrackpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&bbtrackpad>;
    };
};

&bbtrackpad_listener {
    status = "okay";
    /*
     * Automatic mouse layer: while the trackpad reports movement this holds
     * MOUSE_LAYER_ID active, and drops it again once no movement has arrived
     * for the timeout.  The timeout here is only the devicetree default -
     * zmk-feature-zitaotech-trackpad overrides both the timeout (Q20 ships
     * with 800 ms) and whether the layer may come up at all, so ZitaoTech
     * Studio can switch the feature off and change the time.
     */
    input-processors = <&zip_temp_layer MOUSE_LAYER_ID 800>;
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 23)>,
                <NRF_PSEL(TWIM_SCL, 0, 25)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 23)>,
                <NRF_PSEL(TWIM_SCL, 0, 25)>;
            low-power-enable;
        };
    };

    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;      // keyboard backlight
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;      // keyboard backlight
            bias-pull-down;
        };
    };

    pwm1_default: pwm1_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 17)>;      // backlight for layer/Set2
        };
    };

    pwm1_sleep: pwm1_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 17)>;      // backlight for layer/Set2
            bias-pull-down;
        };
    };

    pwm2_default: pwm2_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 15)>;      // backlight for layer
        };
    };

    pwm2_sleep: pwm2_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 15)>;      // backlight for layer
            bias-pull-down;
        };
    };

    pwm3_default: pwm3_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 10)>;      // backlight for trackpad
        };
    };

    pwm3_sleep: pwm3_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 10)>;      // backlight for trackpad
            bias-pull-down;
        };
    };
};

&flash0 {
    /*
     * For more information, see:
     * http://docs.zephyrproject.org/latest/devices/dts/flash_partitions.html
     */
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00001000>;
        };

        code_partition: partition@1000 {
            reg = <0x00001000 0x000d3000>;
        };

        /*
         * Storage partition will be used by FCB/LittleFS/NVS
         * if enabled.
         */
        storage_partition: partition@d4000 {
            reg = <0x000d4000 0x00020000>;
        };

        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};
