# SOC and board symbols come from board.yml / the build target in the new board
# scheme (hardware model v2); assigning them here is no longer allowed.

# (ARM_MPU is selected automatically by the SoC in Zephyr 4.x.)

# The board has no 32.768 kHz crystal, so the Bluetooth low-frequency clock
# runs from the internal RC oscillator.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

# Use pinctrl / enable GPIO
CONFIG_PINCTRL=y
CONFIG_GPIO=y

# Build Configuration
# The UF2 bootloader (and the MBR before it) lives below 0x1000, so the image
# has to be linked into /chosen/zephyr,code-partition.
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y
# &bootloader stores its request in GPREGRET across the reset (nice!nano style).
CONFIG_RETAINED_MEM=y
CONFIG_RETENTION=y
CONFIG_RETENTION_BOOT_MODE=y

# Flash configuration
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Enable Signal Power Plus
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# Sleep Setting
CONFIG_ZMK_SLEEP=n
CONFIG_ZMK_EXT_POWER=y
# timeout for backlight for keyboard in miliseconds
CONFIG_ZMK_IDLE_TIMEOUT=30000

# Keyboard backlight Setting
CONFIG_ZMK_BACKLIGHT=y
CONFIG_ZMK_BACKLIGHT_BRT_START=100
CONFIG_ZMK_BACKLIGHT_BRT_STEP=10
CONFIG_ZMK_BACKLIGHT_ON_START=y
CONFIG_ZMK_BACKLIGHT_AUTO_OFF_IDLE=y

# HID indicator configuration
CONFIG_ZMK_HID_INDICATORS=y

# Enable Mouse / A320 trackpad
CONFIG_INPUT=y
CONFIG_ZMK_POINTING=y
CONFIG_I2C=y
CONFIG_I2C_NRFX=y
CONFIG_A320=y
# Trackpad and the scroll speed setting
CONFIG_A320_TRACKPAD_SCROLL_INTERVAL=50
CONFIG_A320_MOUSE_BASE_SPEED_PERCENT=150
CONFIG_A320_MOUSE_SENS_BASE_PERCENT=40
CONFIG_A320_MOUSE_SENS_STEP_PERCENT=1
# Smooth (high-resolution) scrolling, switchable at runtime from
# ZitaoTech Studio's trackpad page.
CONFIG_ZMK_POINTING_SMOOTH_SCROLLING=y

# Debouncing Setting
CONFIG_ZMK_KSCAN_DEBOUNCE_PRESS_MS=10
CONFIG_ZMK_KSCAN_DEBOUNCE_RELEASE_MS=10

# Enable both USB and BLE
CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y
# Four host profiles, matching the &bt BT_SEL 0..3 keys on layer 2.
CONFIG_BT_MAX_PAIRED=4
CONFIG_BT_MAX_CONN=4

# Vial matrix tester: a second HID instance with 32-byte raw HID reports.
CONFIG_ZITAOTECH_Q20_VIAL_MATRIX=y
CONFIG_USB_HID_DEVICE_COUNT=2
CONFIG_ENABLE_HID_INT_OUT_EP=y
CONFIG_HID_INTERRUPT_EP_MPS=32
CONFIG_USB_MAX_NUM_TRANSFERS=8
CONFIG_USB_DEVICE_SN="vial:f64c2b3c"

# Milliseconds to wait after a setting change before writing it to flash memory
CONFIG_ZMK_SETTINGS_SAVE_DEBOUNCE=1000

# ZMK Studio
CONFIG_ZMK_STUDIO=y
CONFIG_ZMK_STUDIO_LOCKING=n
CONFIG_ZMK_STUDIO_LOCK_ON_DISCONNECT=n

# Runtime macro (create/edit macros live from ZitaoTech Studio / ZMK Studio)
# Stable behavior local IDs keep macro steps valid across reboots/rebuilds.
CONFIG_ZMK_BEHAVIOR_LOCAL_ID_TYPE_CRC16=y
CONFIG_ZMK_RUNTIME_MACRO=y
CONFIG_ZMK_RUNTIME_MACRO_STUDIO_RPC=y
# Runtime combo (create/edit combos live from ZitaoTech Studio / ZMK Studio)
CONFIG_ZMK_RUNTIME_COMBO=y
CONFIG_ZMK_RUNTIME_COMBO_STUDIO_RPC=y
# Device info panel
# (this workspace does not carry the watchdog / kscan-diagnostics modules the
#  old ZMK 3.5 Q20 build used, so those are not enabled here)
CONFIG_ZMK_DEVICE_INFO=y
CONFIG_ZMK_DEVICE_INFO_STUDIO_RPC=y
# Per-host default layer + host OS detection (USB and BLE: the BLE half needs
# Zephyr 4's bt_gatt_authorization_cb, which this tree has)
CONFIG_ZMK_DEFAULT_LAYER=y
CONFIG_ZMK_DEFAULT_LAYER_MAX_INDEX=3
CONFIG_ZMK_DEFAULT_LAYER_STUDIO_RPC=y
CONFIG_ZMK_OS_DETECTION=y
CONFIG_ZMK_OS_DETECTION_STUDIO_RPC=y
CONFIG_ZMK_OS_DETECTION_USB=y
CONFIG_ZMK_OS_DETECTION_BLE=y
# BLE profile naming / unpairing from the Studio "Connection" tab
CONFIG_ZMK_BLE_MANAGEMENT=y
CONFIG_ZMK_BLE_MANAGEMENT_STUDIO_RPC=y
# ZMK core settings exposed over Studio
CONFIG_ZMK_SETTINGS_RPC=y
CONFIG_ZMK_SETTINGS_RPC_STUDIO=y
# ZitaoTech trackpad tab (pointer speed / scroll speed / scroll direction)
CONFIG_ZITAOTECH_TRACKPAD_CONTROL=y
CONFIG_ZITAOTECH_TRACKPAD_CONTROL_STUDIO_RPC=y
# Same DPI grid as the board's previous (ZMK 3.5) firmware: the module's own
# default is 1..100 in steps of 1, but the Q20's &DPI keys were tuned for
# 10..100 in steps of 10 (the driver's A320_DPI_* fallbacks use the same grid).
CONFIG_ZITAOTECH_TRACKPAD_DPI_MIN=10
CONFIG_ZITAOTECH_TRACKPAD_DPI_STEP=10
# Name the Studio shows for the pad, as on the previous firmware.
CONFIG_ZITAOTECH_TRACKPAD_DRIVER_NAME="A320"
# Automatic mouse layer: &zip_temp_layer holds the layer while a finger is on
# the trackpad.  The Q20 keymap is built around it (MOUSE_LAYER_ID in the board
# .dts is 4), so it starts switched on.
CONFIG_ZMK_INPUT_PROCESSOR_TEMP_LAYER=y
CONFIG_ZITAOTECH_TRACKPAD_MOUSE_LAYER_CONTROL=y
CONFIG_ZITAOTECH_TRACKPAD_MOUSE_LAYER_DEFAULT=y
CONFIG_ZITAOTECH_TRACKPAD_MOUSE_LAYER=4
# Q20 has no shoulder keys, so the mode keys sit two positions lower than on
# the Q10: the two left thumb keys are 35 (fast) and 36 (slow), and the
# bottom-left key of the letter block is 25 (direction mode).
CONFIG_ZITAOTECH_TRACKPAD_ARROW_KEY_POSITION=25
CONFIG_ZITAOTECH_TRACKPAD_FAST_KEY_POSITION=35
CONFIG_ZITAOTECH_TRACKPAD_SLOW_KEY_POSITION=36
# Touch hold time: how long the pad still counts as touched after the last
# movement (the automatic mouse layer and the pad LED both follow it).
CONFIG_ZITAOTECH_TRACKPAD_TOUCH_ON_MS=800
# Backlight tab: brightness / on-off plus the per-layer indicator effect.
CONFIG_ZITAOTECH_BACKLIGHT_CONTROL=y
CONFIG_ZITAOTECH_BACKLIGHT_CONTROL_STUDIO_RPC=y
# The custom subsystem (runtime macro) RPC request payload has to fit the whole
# macro RPC frame, so grow the RPC RX buffer along with it.
CONFIG_ZMK_STUDIO_RPC_RX_BUF_SIZE=192
CONFIG_ZMK_STUDIO_RPC_CUSTOM_SUBSYSTEM_REQUEST_PAYLOAD_MAX_BYTES=192
# A full trackpad State response (29 fields) encodes to just under 100 bytes,
# which does not fit ZMK's default 64 byte TX ring buffer.  Let the whole frame
# land in the buffer so it can be handed to the transport in one go.
CONFIG_ZMK_STUDIO_RPC_TX_BUF_SIZE=512
CONFIG_ZMK_LOW_PRIORITY_THREAD_STACK_SIZE=2048
CONFIG_ZMK_CUSTOM_SETTINGS_LARGE_VALUE_MAX_SIZE=256
# zmk-feature-custom-settings registers a settings load path that needs more
# than Zephyr's 1024-byte main stack default on this part.
CONFIG_MAIN_STACK_SIZE=2048

# ---------------------------------------------------------------------------
# Bluetooth pairing behaviour, same as the CH582 keyboard:
# when the host deletes the pairing on its side, that same host may pair again
# and the keyboard overwrites the old keys, so no "clear bond" key press on the
# keyboard is needed any more.
# ---------------------------------------------------------------------------
CONFIG_BT_SMP_ALLOW_UNAUTH_OVERWRITE=y

# Pair with "Just Works" (nothing to type in on the keyboard), which is what the
# CH582 keyboard does.  This overrides the ZMK_BLE_PASSKEY_ENTRY that
# CONFIG_BT_SMP_ALLOW_UNAUTH_OVERWRITE implies by default.
CONFIG_ZMK_BLE_PASSKEY_ENTRY=n

# Log via USB or Segger RTT
CONFIG_ZMK_USB_LOGGING=n
