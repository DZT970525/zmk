/*
 * HackberryPiQ20 - ZitaoTech Q20 (RP2040, wired) ZMK board
 *
 * Pinout taken from the Hackberry Pi V3.0 / Q20 wired schematic:
 *   matrix cols  : GP5 GP4 GP3 GP2 GP1 GP17 GP20
 *   matrix rows  : GP8 GP9 GP10 GP12 GP13 GP14 GP15 GP19
 *   backlight    : GP25 (PWM slice 4B)
 *   layer LED    : GP0  (PWM slice 0A)
 *   trackpad LED : GP11 (PWM slice 5B)
 *   trackpad I2C : SDA GP18 / SCL GP23 @ 0x3B (A320)
 *
 * Copyright (c) 2026 ZitaoTech
 *
 * SPDX-License-Identifier: MIT
 */

/dts-v1/;

#include <raspberrypi/rpi_pico/rp2040.dtsi>
#include <arm/raspberrypi/rp2040-boot-mode-retention.dtsi>

#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/matrix_transform.h>

#include "hackberrypiq20-layouts.dtsi"

/* Keymap layer used as the automatic mouse layer (see &bbtrackpad_listener). */
#define MOUSE_LAYER_ID 4

/ {
    model = "HackberryPiQ20";
    compatible = "zitaotech,hackberrypiq20";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,flash-controller = &ssi;
        zephyr,code-partition = &code_partition;
        zephyr,console = &cdc_acm_uart;
        zmk,kscan = &kscan0;
        zmk,physical-layouts = &hackberrypiq20_layout;
        zmk,backlight = &backlight;
        zmk,layer_indicator = &layer_indicator;
        zmk,trackpad_led = &trackpad_led;
        zmk,studio-rpc-uart = &cdc_acm_uart;
    };

    input_processors {
        /* Holds MOUSE_LAYER_ID while the trackpad reports movement. */
        zip_temp_layer: zip_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
        };
    };

    /* Keyboard backlight under the keys (GP25, PWM slice 4 channel B). */
    backlight: backlight {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm 9 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
    };

    /*
     * Layer indicator (GP0, PWM slice 0 channel A): one LED that shows a
     * different effect for each active layer - the "indicator_layer" of the
     * stock QMK firmware, on LAYER_INDICATOR_LED_PIN.
     */
    layer_indicator: layer_indicator {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm 0 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
    };

    /* Trackpad backlight LED (GP11, PWM slice 5 channel B). */
    trackpad_led: trackpad_led {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm 11 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <8>;
        map = <
RC(2,0)  RC(4,0)  RC(0,0)  RC(5,0)  RC(7,6)
RC(1,1)  RC(0,1)  RC(1,3)  RC(1,2)  RC(4,2)  RC(4,5)  RC(1,5)  RC(4,4)  RC(1,4)  RC(6,3)
RC(6,1)  RC(0,3)  RC(4,3)  RC(2,2)  RC(0,2)  RC(0,5)  RC(2,5)  RC(2,4)  RC(0,4)  RC(6,4)
RC(5,1)  RC(3,3)  RC(5,3)  RC(3,2)  RC(5,2)  RC(5,5)  RC(3,5)  RC(3,4)  RC(5,4)  RC(6,5)
RC(2,3)  RC(2,1)  RC(3,1)  RC(4,1)  RC(6,2)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio0 5  GPIO_ACTIVE_HIGH>
            , <&gpio0 4  GPIO_ACTIVE_HIGH>
            , <&gpio0 3  GPIO_ACTIVE_HIGH>
            , <&gpio0 2  GPIO_ACTIVE_HIGH>
            , <&gpio0 1  GPIO_ACTIVE_HIGH>
            , <&gpio0 17 GPIO_ACTIVE_HIGH>
            , <&gpio0 20 GPIO_ACTIVE_HIGH>
            ;
    };
};

/*
 * Boot-mode retention hardening.
 *
 * Zephyr's stock RP2040 retention area is a single byte at the start of SRAM
 * (0x20000000) that the C runtime deliberately does not clear, and
 * bootmode_check() trusts it as-is: the board jumps into the ROM bootloader
 * when that byte happens to read as BOOT_MODE_TYPE_BOOTLOADER (1).  On a cold
 * power-up the byte holds whatever the SRAM powered up with, so roughly one
 * boot in 256 went straight to the bootloader (RPI-RP2) instead of running the
 * firmware.
 *
 * Giving the area a magic prefix and a CRC8 footer makes a random byte fail
 * validation, while &bootloader still works because bootmode_set() writes the
 * prefix, the value and the checksum together.  The region reserves four
 * bytes: 2 prefix + 1 value + 1 checksum.
 */
&boot_mode {
    reg = <0x0 0x4>;
    prefix = [5a a5];
    checksum = <1>;
};

/* 2 MB QSPI flash (W25Q16). */
&flash0 {
    reg = <0x10000000 DT_SIZE_M(2)>;

    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        second_stage_bootloader: partition@0 {
            label = "second_stage_bootloader";
            reg = <0x00000000 0x100>;
            read-only;
        };

        code_partition: partition@100 {
            label = "code-partition";
            reg = <0x100 (DT_SIZE_M(2) - 0x100 - DT_SIZE_K(512))>;
            read-only;
        };

        /* Settings / NVS store. */
        storage_partition: partition@180000 {
            label = "storage";
            reg = <0x180000 DT_SIZE_K(512)>;
            read-only;
        };
    };
};

&timer {
    status = "okay";
};

&rtc {
    clocks = <&clocks RPI_PICO_CLKID_CLK_RTC>;
    status = "okay";
};

&vreg {
    regulator-always-on;
    regulator-allowed-modes = <REGULATOR_RPI_PICO_MODE_NORMAL>;
};

&gpio0 {
    status = "okay";
};

&usbd {
    status = "okay";
    cdc_acm_uart: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

zephyr_udc0: &usbd {
    status = "okay";
};

&pwm {
    status = "okay";
    pinctrl-0 = <&pwm_gp0_default &pwm_gp11_default &pwm_gp25_default>;
    pinctrl-names = "default";
};

&pinctrl {
    pwm_gp0_default: pwm_gp0_default {
        group1 {
            pinmux = <PWM_0A_P0>; /* layer indicator */
        };
    };

    pwm_gp11_default: pwm_gp11_default {
        group1 {
            pinmux = <PWM_5B_P11>; /* trackpad backlight */
        };
    };

    pwm_gp25_default: pwm_gp25_default {
        group1 {
            pinmux = <PWM_4B_P25>; /* keyboard backlight */
        };
    };

    i2c1_default: i2c1_default {
        group1 {
            pinmux = <I2C1_SDA_P18>, <I2C1_SCL_P23>;
            input-enable;
            input-schmitt-enable;
        };
    };
};

&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c1_default>;
    pinctrl-names = "default";

    bbtrackpad: a320@3b {
        compatible = "avago,a320";
        reg = <0x3b>;
        status = "okay";
    };
};

/ {
    bbtrackpad_listener: bbtrackpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&bbtrackpad>;
    };
};

&bbtrackpad_listener {
    status = "okay";
    /*
     * Automatic mouse layer: while the trackpad reports movement this holds
     * MOUSE_LAYER_ID active, and drops it again once no movement has arrived
     * for the timeout.  zmk-feature-zitaotech-trackpad overrides both the
     * timeout (Q20 ships with 800 ms) and whether the layer may come up at
     * all, so ZitaoTech Studio can switch the feature off and change the time.
     */
    input-processors = <&zip_temp_layer MOUSE_LAYER_ID 800>;
};
