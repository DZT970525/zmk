/* Keep ZMK's native to-layer behavior compiled in, otherwise /omit-if-no-ref/ drops
 * the node and ZMK Studio cannot offer "To Layer".
 */
#define ZMK_BEHAVIORS_KEEP_TO

#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/trackpad_dpi.dtsi>
#include <behaviors/trackpad_mode.dtsi>

#define DEFAULT 0
#define SYM 1
#define UPPER 2
#define MEDIA 3

/* Must match the command codes in custom_driver/a320.h:
 * TP_NONE_CMD = 0, TP_INC_CMD = 1, TP_DEC_CMD = 2. They used to be off by one
 * here, which made &DPI TP_DEC increase the DPI and &DPI TP_INC do nothing. */
#define TP_NONE 0
#define TP_INC 1
#define TP_DEC 2

/* &TP command codes, mirroring custom_driver/behavior_trackpad_mode.c.  The key
 * does nothing until "enable the mode switch key" is turned on in ZitaoTech
 * Studio. */
#define TP_MODE_TOGGLE 0

#define SL_MO(layer) &sl_mo layer layer //tap -> sticky layer, hold -> momentary layer

&sl {
    release-after-ms = <3000>;
    };

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&none>;
        };
    };
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&mo &kp>;
        };
    };

    behaviors {
    lt: Layer_Tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <400>;
            bindings = <&mo>, <&kp>;
        };
    };

    behaviors {
    sl_mo: behavior_sl_mo {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "hold-preferred";      /* 单击优先 */
        tapping-term-ms = <450>;       /* 长按阈值 */
        bindings = <&mo &sl>;          /* hold=MO, tap=SL */
        };
    };

    behaviors {
        tdc_to_SYM: td_comma_to_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mt DLLR SEMI>, <&to SYM>;
        };
    };

    behaviors {
        tdc_to_MEDIA: td_mute_to_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp C_MUTE>, <&to MEDIA>;
        };
    };

    behaviors {
        td_boot_out: td_boot_out {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <500>;           
            bindings = <&bootloader>, <&none>;
        };
    };

    behaviors {
    sk_kp: behavior_sk_kp {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "hold-preferred";      
        tapping-term-ms = <600>;       
        bindings = <&kp &sk>;          /* hold=kp, tap=sticky key */
        };
    };

    behaviors {
         M_kp: behavior_mouse_keypress {
           compatible = "zmk,behavior-hold-tap";
           #binding-cells = <2>;
           flavor = "tap-preferred";     /* 单击优先 */
           tapping-term-ms = <500>;       /* 长按阈值 */
           bindings = <&mkp &kp>;        /* hold=mou key press, tap=key*/
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {

            bindings = <
//         --------------------------------------------------------------------------------------------------------------------------         
// |         Call key      |      Blackberry Key        |    Trackpad    |             Back Key                |             Endcall Key          |
// |     Q      |     W    |     E    |     R    |      T      |       Y        |       U        |        I        |       O      |      P        |     
// |     A      |     S    |     D    |     F    |      G      |       H        |       J        |        K        |       L      |      ←        |  
// |     alt    |     Z    |     X    |     C    |      V      |       B        |       N        |        M        |       $      |    Enter      |   
//        |         aA     |         0           |           SPACE              |         SYM         |        aA          |       
//        -----------------------------------------------------------------------------------------------------------------

    &M_kp MB1 CLCK          &kp LGUI                            &mkp LCLK                          &mt F4 K_BACK                     &M_kp MB2 TAB
    &kp Q        &kp W      &kp E       &kp R     &kp T         &kp Y             &kp U            &kp I            &kp O            &kp P
    &kp A        &kp S      &kp D       &kp F     &kp G         &kp H             &kp J            &kp K            &kp L            &kp BSPC
    &kp LSHFT    &kp Z      &kp X       &kp C     &kp V         &kp B             &kp N            &kp M            &tdc_to_SYM      &kp ENTER
    &sk_kp LCTRL  LCTRL     &kp LALT                            &kp SPACE                          &sl_mo 1 1                        &sl_mo 2 2
            >;
        };

                        
        sym_layer {

            bindings = <        
    &kp PSCRN               &kp C_AC_SEARCH                     &mkp LCLK                          &kp F5                            &kp F12 
    &kp HASH     &kp N1     &kp N2      &kp N3    &mt LBKT LPAR &mt RBKT RPAR     &kp UNDER        &kp MINUS        &kp PLUS         &kp AT
    &kp STAR     &kp N4     &kp N5      &kp N6    &kp SLASH     &kp COLON         &kp SEMI         &kp APOS         &kp DQT          &kp DEL
    &kp LSHFT    &kp N7     &kp N8      &kp N9    &kp QMARK     &kp EXCL          &kp COMMA        &kp DOT          &tdc_to_MEDIA    &kp ENTER
    &kp LCTRL               &kp N0                              &kp SPACE                          &to DEFAULT                       &sl_mo 2 2
            >;
        };

        upper_layer {

            bindings = <
    &none                   &none                                    &td0                           &none                            &none
    &none        &kp UP     &kp C_EJECT &sys_reset &none            &none         &kp LT           &kp GT          &kp PIPE         &kp KP_EQUAL
    &kp LEFT     &kp DOWN   &kp RIGHT   &none      &kp BSLH          &kp AMPS      &kp LBRC         &kp RBRC        &kp CARET        &kp BSPC
    &kp LSHFT    &none      &TP TP_MODE_TOGGLE &bl BL_DEC &DPI TP_DEC  &bl BL_TOG    &DPI TP_INC      &bl BL_INC      &td_boot_out     &kp ENTER
    &kp LCTRL               &kp LALT                                 &hm 0 SPACE                    &to DEFAULT                      &to DEFAULT
                >;
        };

                media_layer {

            bindings = <
    &none                  &none                               &none                         &none                            &none
    &none        &none     &none       &none      &none        &none         &none           &none           &none            &none
    &none        &none     &none       &none      &none        &none         &none           &none           &none            &none
    &none        &none     &none       &none      &none        &none         &none           &none           &to DEFAULT      &none
    &none                  &none                               &none                         &to DEFAULT                      &to DEFAULT
            >;
        };

        /*
         * Automatic mouse layer (index 4).  Q20 ships with it switched on in
         * ZitaoTech Studio; &zip_temp_layer holds it while a finger is on the
         * trackpad.
         *
         * Everything is transparent, so the keys behave exactly like layer 0;
         * only the mouse buttons differ: Q is the left button and the last key
         * of the top row (the Endcall key, position 4) is the right button.
         * Pressing a key needs less force than pressing the trackpad, which
         * makes dragging smooth.
         */
        mouse_layer {

            bindings = <
    &trans                  &trans                               &trans                        &trans                             &mkp RCLK
    &mkp LCLK    &trans     &trans      &trans    &trans        &trans        &trans           &trans           &trans            &trans
    &trans       &trans     &trans      &trans    &trans        &trans        &trans           &trans           &trans            &trans
    &trans       &trans     &trans      &trans    &trans        &trans        &trans           &trans           &trans            &trans
    &trans                  &trans                               &trans                         &trans                            &trans
            >;
        };
    };
};
