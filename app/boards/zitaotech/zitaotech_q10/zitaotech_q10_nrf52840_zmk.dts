/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/keys.h>
#include <behaviors/runtime_tap_dance.dtsi>
#define ZMK_BEHAVIORS_KEEP_DEFAULT_LAYER
#include <behaviors/default_layer.dtsi>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>

/* Keymap layer used as the automatic mouse layer (see &bbtrackpad_listener). */
#define MOUSE_LAYER_ID 4

/ {
    input_processors {
        /* Holds MOUSE_LAYER_ID while the trackpad reports movement. */
        zip_temp_layer: zip_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
        };
    };
};
#include "zitaotech_q10-layouts.dtsi"

/ {
    model = "zitaotech_q10";
    compatible = "ZitaoTech,zitaotech_q10";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,console = &cdc_acm_uart;
        zmk,battery = &vbatt;
        zmk,kscan = &kscan0;
        zmk,physical-layouts = &zitaotech_q10_layout;
        zmk,keyboard_backlight = &keyboard_backlight;
        zmk,layer_indicator = &keyboard_backlight;
        zmk,trackpad_led = &trackpad_led;
        zmk,backlight = &backlight;
        zmk,studio-rpc-uart = &cdc_acm_uart; // ✅ enable ZMK Studio
    };

    keyboard_backlight: pwmledfo{
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm2 0 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
    };

    trackpad_led: pwmledo{
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm1 0 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
    };

    backlight: pwmleds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
        };
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <9>;
        map = <
RC(8,1)                                                                   RC(8,5)
RC(7,1)          RC(8,3)             RC(7,2)             RC(8,4)          RC(7,5)
RC(0,0)  RC(1,0) RC(0,1) RC(0,2) RC(2,2) RC(2,3) RC(0,3) RC(2,4) RC(0,4)  RC(3,1)
RC(3,0)  RC(1,1) RC(2,1) RC(6,2) RC(1,2) RC(1,3) RC(6,3) RC(6,4) RC(1,4)  RC(3,4)
RC(4,0)  RC(5,1) RC(4,1) RC(5,2) RC(4,2) RC(4,3) RC(5,3) RC(5,4) RC(4,4)  RC(3,3)
RC(6,1)          RC(6,0)             RC(5,0)             RC(2,0)          RC(3,2)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        /*
         * The Q10 matrix has no diodes.  Keep the unselected columns high
         * impedance (open source, driven high only while selected) so that
         * two keys in the same row do not short two actively driven columns
         * together.  The rows stay pulled down and read high when pressed.
         */
        row-gpios
            = <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 13  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 29  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 30  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&gpio0 14  (GPIO_ACTIVE_HIGH | GPIO_OPEN_SOURCE)>
            , <&gpio0 15  (GPIO_ACTIVE_HIGH | GPIO_OPEN_SOURCE)>
            , <&gpio0 17  (GPIO_ACTIVE_HIGH | GPIO_OPEN_SOURCE)>
            , <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_SOURCE)>
            , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_OPEN_SOURCE)>
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_OPEN_SOURCE)>
            ;
    };

    leds {
        compatible = "gpio-leds";
        blue_led: led_0 {
            gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
        };
    };

    // Node name must match original "EXT_POWER" label to preserve user settings.
    EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 2>;
        output-ohms = <2000000>;
        full-ohms = <2820000>;  // 2000000 + 820000
    };
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_default>;
    pinctrl-1 = <&pwm1_sleep>;
    pinctrl-names = "default", "sleep";
};

&pwm2 {
    status = "okay";
    pinctrl-0 = <&pwm2_default>;
    pinctrl-1 = <&pwm2_sleep>;
    pinctrl-names = "default", "sleep";
};




&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    bbtrackpad:a320@3b {
        compatible = "avago,a320";
        reg = <0x3B>;
        status = "okay";
    };
};


/ {
    bbtrackpad_listener: bbtrackpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&bbtrackpad>;
    };
};

&bbtrackpad_listener {
    status = "okay";
    /*
     * Automatic mouse layer: while the trackpad reports movement this holds
     * MOUSE_LAYER_ID active, and drops it again once no movement has arrived
     * for the timeout.  The timeout here is only the devicetree default -
     * zmk-feature-zitaotech-trackpad overrides both the timeout and whether
     * the layer may come up at all, so ZitaoTech Studio can switch the feature
     * off and change the time.
     */
    input-processors = <&zip_temp_layer MOUSE_LAYER_ID 1000>;
};



&usbd {
    status = "okay";
    cdc_acm_uart: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

&zitaotech_q10_layout{
	transform = <&default_transform>;
	kscan = <&kscan0>;
};

zephyr_udc0: &usbd {
    compatible = "nordic,nrf-usbd";
    status = "okay";
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 9)>,
                <NRF_PSEL(TWIM_SCL, 0, 8)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 9)>,
                <NRF_PSEL(TWIM_SCL, 0, 8)>;
            low-power-enable;
        };
    };
    pwm0_default:pwm0_default{
        group1{
            psels = <NRF_PSEL(PWM_OUT0, 1, 4)>; // Backlight for backlight.c unreal
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 4)>;
            bias-pull-down;
        };
    };

    pwm1_default:pwm1_default{
        group1{
            psels = <NRF_PSEL(PWM_OUT0, 1, 13)>; // Backlight for Trackpad LED
        };
    };

    pwm1_sleep: pwm1_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;
            bias-pull-down;
        };
    };

    pwm2_default: pwm2_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 6)>; // Backlight for Keyboard middle LED
        };
    };

    pwm2_sleep: pwm2_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 6)>;
            bias-pull-down;
        };
    };
};

&flash0 {
    /*
     * For more information, see:
     * http://docs.zephyrproject.org/latest/devices/dts/flash_partitions.html
     */
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00001000>;
        };

        code_partition: partition@1000 {
            reg = <0x00001000 0x000d3000>;
        };

        /*
         * The flash starting at 0x000d4000 and ending at
         * 0x000f3fff is reserved for use by the application.
         */

        /*
         * Storage partition will be used by FCB/LittleFS/NVS
         * if enabled.
         */
        storage_partition: partition@d4000 {
            reg = <0x000d4000 0x00020000>;
        };

        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};
