/* Keep ZMK's native to-layer behavior compiled in, otherwise /omit-if-no-ref/ drops
 * the node and ZMK Studio cannot offer "To Layer".
 */
#define ZMK_BEHAVIORS_KEEP_KT
#define ZMK_BEHAVIORS_KEEP_TO

/* Keep the default-layer behavior in the devicetree even if no key is bound to
 * it: the per-endpoint / per-OS default layer is configured from ZitaoTech
 * Studio, and the module only compiles when its node exists. */
#define ZMK_BEHAVIORS_KEEP_DEFAULT_LAYER

#include <behaviors.dtsi>
#include <behaviors/configurable_mod_tap.dtsi>
#include <behaviors/layer_mod.dtsi>
#include <behaviors/mouse_key_toggle.dtsi>
/* The per-endpoint default layer (ZitaoTech Studio's "default layer" page). */
#include <behaviors/default_layer.dtsi>
/* Runtime rotary-encoder bindings: the encoders bind &rsr_*, whose
 * clockwise/counter-clockwise actions ZitaoTech Studio can change live. */
#include <behaviors/runtime-sensor-rotate.dtsi>
/* Runtime macro behavior (&rmacro <slot>): macro bodies are stored/edited from
 * ZitaoTech Studio through the custom settings subsystem. */
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime_tap_dance.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/ext_power.h>

#define FUNC 1
#define RES 2
#define BOT bootloader

/* 0 is the empty placeholder used by ZMK Studio, so the real values start at 1. */
#define TPad 1
#define TPoint 2
#define DPI_INC 1
#define DPI_DEC 2

/* &TP command code, mirroring custom_driver/behavior_trackpad_mode.c: toggle
 * the trackpad between pointer mode and direction mode.  The key does nothing
 * until "enable the mode switch key" is turned on in ZitaoTech Studio. */
#define TP_MODE_TOGGLE 0

/ {
    input_processors {

        zip_temp_layer: zip_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
        };

        ip_behaviors0: ip_behaviors0 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_0>;
            bindings = <&kp RIGHT>;
        };
        ip_behaviors1: ip_behaviors1 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_1>;
            bindings = <&kp LEFT>;
        };
        ip_behaviors2: ip_behaviors2 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_2>;
            bindings = <&kp DOWN>;
        };
        ip_behaviors3: ip_behaviors3 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_3>;
            bindings = <&kp UP>;
        };
    };
};

/ {

    behaviors {
        connection_mode: connection_mode {
            compatible = "zmk,behavior-keypoint-connection-mode";
            #binding-cells = <0>;
            display-name = "MACINTOSCH OUTPUT SWITCH";
        };
        display_mode: display_mode {
            compatible = "zmk,behavior-keypoint-display-mode";
            #binding-cells = <0>;
            display-name = "SCREEN MODE SWITCH";
        };
        mouse_lt: Mouse_Layer_Tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&mo>, <&mkp>;
        };
    };

    behaviors {

    lt: Layer_Tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <400>;
            bindings = <&mo>, <&kp>;
        };
    };

    behaviors {

        tdRMCLK: tap_dance_R_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;
        };
    };

    behaviors {

        hm: Homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {

         sp_sc: behavior_spacescroll {
           compatible = "zmk,behavior-hold-tap";
           #binding-cells = <2>;
           flavor = "tap-preferred";     /* 单击优先 */
           tapping-term-ms = <250>;       /* 长按阈值 */
           bindings = <&none &kp>;        /* hold=none, tap=space */
        };
    };

    behaviors {

         LMouse_sc: behavior_LMouse_Scroll {
           compatible = "zmk,behavior-hold-tap";
           #binding-cells = <2>;
           flavor = "tap-preferred";     /* 单击优先 */
           tapping-term-ms = <250>;       /* 长按阈值 */
           bindings = <&none &mkp>;        /* hold=none, tap=Lmouse */
        };
    };

    behaviors {

         M_kp: Mkey_keypress {
           compatible = "zmk,behavior-hold-tap";
           #binding-cells = <2>;
           flavor = "tap-preferred";     /* 单击优先 */
           tapping-term-ms = <250>;       /* 长按阈值 */
           bindings = <&mkp &kp>;        /* hold=mou key press, tap=key*/
        };
    };

    behaviors {

        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };

        /* Factory encoder map, kept as the runtime behaviors' fallback so the
         * Studio-edited bindings start from the shipped feel:
         *   layer 0: left = volume, right = Left/Right arrow
         *   LOWER:   left = Bluetooth profile next/prev, right = Up/Down arrow
         * A layer's sensor-binding points at these nodes; a binding stored from
         * Studio overrides that node's defaults per layer. */
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_arrow_lr: rsr_arrow_lr {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp RIGHT>;
            ccw-binding = <&kp LEFT>;
        };

        rsr_bt_profile: rsr_bt_profile {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&bt BT_NXT>;
            ccw-binding = <&bt BT_PRV>;
        };

        rsr_arrow_ud: rsr_arrow_ud {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp DOWN>;
            ccw-binding = <&kp UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

         default_layer {
            display-name = "QWERTY";
           bindings = <

&mt ESC TAB &kp Q  &kp W      &kp E      &kp R     &kp T                                                                 &kp Y       &kp U    &kp I      &kp O     &kp P     &kp BSPC
&kp CAPS  &kp A    &kp S      &kp D      &kp F     &kp G     &mkp LCLK                    &mkp LCLK                      &kp H       &kp J    &kp K      &kp L     &kp SEMI  &kp ENTER
&kp LSHFT &kp Z    &kp X      &kp C      &kp V     &kp B     &kp PG_DN  &kp PG_UP         &msc SCRL_DOWN  &msc SCRL_UP   &kp N       &kp M    &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LCTRL &kp LGUI &kp LALT   &kp C_MUTE &mo 2     &kp SPACE &mo 1                                        &mo 1          &kp SPACE   &mo 2    &kp C_MUTE &kp MINUS &kp EQUAL &kp GRAVE
           >;
           /* Runtime encoder map: one entry per encoder (left half, then right
            * half).  The &rsr_* behaviours carry the factory defaults and can be
            * re-bound live from ZitaoTech Studio. */
           sensor-bindings = <&rsr_vol &rsr_arrow_lr>;
        };


        lower_layer {
            display-name = "LOWER";
            bindings = <

&kp ESC   &kp N1    &kp N2     &kp N3       &kp N4   &kp N5                                                                         &kp N6    &kp N7   &kp N8       &kp N9    &kp N0     &kp DEL
&kp CAPS  &kp LEFT &kp DOWN &kp RIGHT &trans   &trans         &mkp RCLK                    &mkp RCLK                          &trans    &trans   &trans       &trans    &kp SQT    &kp ENTER
&kp LSHFT &trans    &TP TP_MODE_TOGGLE     &display_mode       &trans   &connection_mode         &DPI TPad DPI_DEC &DPI TPad DPI_INC  &DPI TPoint DPI_DEC &DPI TPoint DPI_INC    &trans    &trans   &kp LBKT     &kp RBKT  &kp BSLH   &kp RSHFT
&kp LCTRL &kp LGUI  &BOT       &bt BT_CLR   &trans   &kp SPACE      &mo 1                                                &mo 1      &kp SPACE &to 3    &out OUT_TOG &BOT      &trans     &trans
            >;
            sensor-bindings = <&rsr_bt_profile &rsr_arrow_ud>;
        };
        raise_layer {
            display-name = "RAISE";
            bindings = <

&kp ESC       &kp F1    &kp UP     &kp F3    &kp F4   &kp F5                                                    &kp F6      &kp F7  &kp F8   &kp F9  &kp F10  &none
&kp CAPS      &kp LEFT  &kp DOWN   &kp RIGHT &none    &none   &none                        &none                &kp F11     &kp F12 &none    &none  &none     &none
&kp LSHFT     &none     &none      &none     &none    &none   &none   &none                &none  &none         &none       &none   &none    &none  &none     &none
&kp LCTRL     &kp LGUI  &none      &none     &mo 2    &none   &none                               &none         &none       &mo 2   &none    &none  &none     &none
            >;
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };
        MOUSE_layer {
            display-name = "MOUSE";
            bindings = <

&kp TAB   &kp Q     &kp W          &kp E     &kp R     &kp T                                                         &kp Y       &M_kp MB3 U    &kp I      &kp O     &kp P     &kp BSPC
&kp CAPS  &kp A     &kp S          &kp D     &kp F     &kp G      &mkp LCLK                         &mkp LCLK        &kp H       &M_kp MB1 J    &kp K      &kp L     &kp SEMI  &kp ENTER
&kp LSHFT &kp Z     &kp X          &kp C     &kp V     &kp B      &msc SCRL_DOWN   &msc SCRL_UP     &none  &none     &kp N       &M_kp MB2 M    &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LCTRL &kp LGUI  &kp  LALT      &none     &mo 2     &kp SPACE  &mkp MB1                         &mouse_lt 1 MB1  &tdRMCLK    &mo 2          &kp C_MUTE &kp MINUS &kp EQUAL &kp GRAVE
            >;
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };
        RES_layer {
            display-name = "RESERVE";
            bindings = <

&none     &none     &none      &none    &none    &none                                                 &none   &none  &none   &none  &none  &none
&none     &none     &none      &none    &none    &none   &none                        &none            &none   &none  &none   &none  &none  &none
&none     &none     &none      &none    &none    &none   &none   &none                &none  &none     &none   &none  &none   &none  &none  &none
&none     &none     &none      &none    &none    &none   &none                               &none     &none   &none  &none   &none  &none  &none
            >;
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        /*
         * Spare layer slots for ZitaoTech Studio.
         *
         * With CONFIG_ZMK_KEYMAP_LAYER_REORDERING (pulled in by ZMK_STUDIO_RPC)
         * every child of this node counts as a layer position, but non-"okay"
         * nodes stay unassigned - which is exactly what
         * zmk_keymap_add_layer() looks for to add a layer at runtime.  Their key bindings stay empty; runtime encoder dispatch remains wired
         * so layers added in Studio can use per-layer rotary settings.  Same trick as cormoran's
         * dya2 keymap (extra1..extra4 { status = "reserved"; }).
         *
         * Without at least one of these the central reports
         * available_layers = 0 and Studio's "Add new layer" button stays
         * disabled.  The peripheral half does not enable layer reordering, so
         * for it only the "okay" layers above exist and this costs it nothing.
         */
        extra1 { status = "reserved"; sensor-bindings = <&rsr_trans &rsr_trans>; };
        extra2 { status = "reserved"; sensor-bindings = <&rsr_trans &rsr_trans>; };
        extra3 { status = "reserved"; sensor-bindings = <&rsr_trans &rsr_trans>; };
        extra4 { status = "reserved"; sensor-bindings = <&rsr_trans &rsr_trans>; };
    };
};
