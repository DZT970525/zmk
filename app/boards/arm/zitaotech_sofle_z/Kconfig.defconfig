if BOARD_ZITAOTECH_SOFLE_Z_RIGHT

config ZMK_KEYBOARD_NAME
    default "ZITAOTECH_SOFLE_Z"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # BOARD_ZITAOTECH_SOFLE_Z_RIGHT


if BOARD_ZITAOTECH_SOFLE_Z_LEFT || BOARD_ZITAOTECH_SOFLE_Z_RIGHT

if ZMK_BACKLIGHT

config PWM
    default y

config LED_PWM
    default y

endif # ZMK_BACKLIGHT

config BOARD
    default "ZITAOTECH_SOFLE_Z"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_PERIPHERAL_HID_INDICATORS
    default y

config BT_CTLR
    default BT

endif # BOARD_ZITAOTECH_SOFLE_Z_LEFT || BOARD_ZITAOTECH_SOFLE_Z_RIGHT
